<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalMind.AgentHub"
        x:Class="LocalMind.AgentHub.MainWindow" x:DataType="vm:HubViewModel"
        Title="LocalMind · Agent Hub" Width="1080" Height="670" MinWidth="680" MinHeight="430"
        Background="#111B21" Foreground="#EEF5F1">
  <Grid RowDefinitions="Auto,*">
    <Border Background="#18262B" Padding="24,16" BorderBrush="#36474A" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Border Background="#BBE5CA" CornerRadius="5" Padding="7,3"><TextBlock Text="LM" FontWeight="Bold" Foreground="#16372A"/></Border>
          <TextBlock Text="LocalMind  /  Agent Hub" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1" Click="OpenProfile" Content="Open database…"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="220,*">
      <Border Background="#152127" BorderBrush="#36474A" BorderThickness="0,0,1,0" Padding="18,25">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <TextBlock Text="PROJECTS" Foreground="#A9C6BD" FontSize="12" FontWeight="Bold" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" AutomationProperties.Name="Local projects">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectItem"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="Local workspace · Read-only" Foreground="#A9C6BD" FontSize="12"/>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="28" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="15">
        <TextBlock Text="PROJECT WORKSPACE" Foreground="#A3D8BD" FontSize="12" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Text="{Binding ProjectHeading}" FontSize="29" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StatusText}" Foreground="#BDD0CB" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="Refresh"/>
        </Grid>
        <ListBox x:Name="TaskList" Grid.Row="3" ItemsSource="{Binding Tasks}" AutomationProperties.Name="Tasks and prerequisites">
          <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskItem">
              <Border BorderBrush="#3A4A4F" BorderThickness="0,0,0,1" Padding="6,12">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                  <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <Border Grid.Column="1" CornerRadius="4" Background="#294238" Padding="8,3"><TextBlock Foreground="#BAE9CE" Text="{Binding Status}" /></Border>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding OwnerLabel, StringFormat='Owner: {0}'}" Foreground="#BDCFCA" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="2" Text="{Binding DependencySummary}" Foreground="#D4DDD9" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <Button Grid.Row="2" Grid.Column="1" Content="Go to blocker" IsVisible="{Binding HasBlocker}"
                          AutomationProperties.Name="{Binding Title, StringFormat='Go to blocker for {0}'}" Click="GoToBlocker"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Grid>
</Window>
