<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../agent-hub-core/LocalMind.AgentHub.Core.csproj" />
    <ProjectReference Include="../agent-hub-worker/LocalMind.AgentHub.Worker.csproj" />
  </ItemGroup>
  <!-- The control gallery exists only in Debug builds, so it cannot reach a shipped app. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <AvaloniaXaml Remove="Gallery/**" />
    <Compile Remove="Gallery/**" />
  </ItemGroup>
</Project>
