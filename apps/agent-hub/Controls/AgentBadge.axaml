<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LocalMind.AgentHub.Controls" xmlns:c="using:LocalMind.AgentHub.Controls"
             x:Class="LocalMind.AgentHub.Controls.AgentBadge" x:DataType="vm:AgentIdentity">
  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Badge}" VerticalAlignment="Top">
      <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource BadgeText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1" Spacing="2">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <c:StatusChip Text="Fixture" IsVisible="{Binding IsFixture}"/>
      </StackPanel>
      <TextBlock Text="{Binding Role, StringFormat='Role: {0}'}" Foreground="{DynamicResource Muted}" IsVisible="{Binding HasRole}"/>
      <TextBlock Text="{Binding Provider, StringFormat='Provider: {0}'}" Foreground="{DynamicResource Muted}" IsVisible="{Binding HasProvider}"/>
    </StackPanel>
  </Grid>
</UserControl>
