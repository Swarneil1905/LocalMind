<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LocalMind.AgentHub.Controls.StatusChip">
  <UserControl.Styles>
    <Style Selector="Border#Root"><Setter Property="Background" Value="{DynamicResource Badge}"/></Style>
    <Style Selector="Border#Root > TextBlock"><Setter Property="Foreground" Value="{DynamicResource BadgeText}"/></Style>
    <Style Selector="Border#Root.error"><Setter Property="Background" Value="{DynamicResource ErrorFill}"/></Style>
    <Style Selector="Border#Root.error > TextBlock"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/></Style>
    <Style Selector="Border#Root.busy"><Setter Property="Background" Value="{DynamicResource BusyFill}"/></Style>
  </UserControl.Styles>
  <Border x:Name="Root" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Top">
    <TextBlock x:Name="Label" TextWrapping="NoWrap"/>
  </Border>
</UserControl>
