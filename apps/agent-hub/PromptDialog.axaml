<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LocalMind.AgentHub.PromptDialog"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Pane}">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="Label1" FontWeight="SemiBold"/>
    <TextBox x:Name="Field1" AutomationProperties.Name="First field" MaxLength="200"/>
    <ComboBox x:Name="Choices" HorizontalAlignment="Stretch" IsVisible="False" AutomationProperties.Name="Choose a task"/>
    <TextBlock x:Name="Label2" FontWeight="SemiBold" IsVisible="False"/>
    <TextBox x:Name="Field2" IsVisible="False" AutomationProperties.Name="Second field" AcceptsReturn="False"/>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Click="Cancel"/>
      <Button x:Name="OkButton" Content="Save" IsDefault="True" Click="Ok"/>
    </StackPanel>
  </StackPanel>
</Window>
